            xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
            xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
            xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#">
         <dc:format>application/postscript</dc:format>
         <dc:identifier>doi:10.1038/s41598-020-58660-w</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Springer US</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Scientific Reports, doi:10.1038/s41598-020-58660-w</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Charge transport mechanism in networks of armchair graphene nanoribbons</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Nils Richter</rdf:li>
               <rdf:li>Zongping Chen</rdf:li>
               <rdf:li>Alexander Tries</rdf:li>
               <rdf:li>Thorsten Prechtl</rdf:li>
               <rdf:li>Akimitsu Narita</rdf:li>
